# Executor: local | xai | openai
# local  = 局域网 llama.cpp（无 Key，走 /v1/responses）
# xai    = xAI Grok（Chat Completions + Bearer）
# openai = OpenAI 兼容（官方 / 智谱 GLM 等，Chat Completions + Bearer）
#
# 免费实现示例：openai + 智谱 glm-4-flash-250414
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.2

# chat = POST {base}/chat/completions
# responses = POST {base}/responses（llama.cpp / 部分 OpenAI 兼容）
LOCAL_AGENT_API=chat

# --- openai 兼容（含智谱 Coding API）---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
OPENAI_MODEL=glm-4-flash-250414

# --- xAI ---
# LLM_PROVIDER=xai
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-reasoning
XAI_BASE_URL=https://api.x.ai/v1

# --- 本机 / 局域网 llama.cpp ---
# LLM_PROVIDER=local
# LOCAL_AGENT_API=responses
LOCAL_AGENT_ENDPOINT=http://192.168.7.182:18080/v1
LOCAL_AGENT_MODEL=DeepSeek-V4-Pro-Qwen3.5-9B
LLAMA_HOST=192.168.7.182
LLAMA_PORT=18080
LLAMA_CTX=65536
